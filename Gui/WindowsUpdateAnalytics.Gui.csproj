<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Wupa</RootNamespace>
    <AssemblyName>WUPA</AssemblyName>
    <Version>3.2.3</Version>
    <FileVersion>3.2.3.0</FileVersion>
    <AssemblyVersion>3.2.3.0</AssemblyVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WUPA.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\WUPA-256.png" LogicalName="Wupa.BrandLogo" />
    <EmbeddedResource Include="Assets\UpdatePublicKey.pem" LogicalName="Wupa.UpdatePublicKey" />
    <EmbeddedResource Include="..\Assets\**\*" LogicalName="Payload/Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Data\**\*" LogicalName="Payload/Data/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Modules\**\*" LogicalName="Payload/Modules/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\BundleManifest.sha256" LogicalName="Payload/BundleManifest.sha256" />
    <EmbeddedResource Include="..\Invoke-Win11UpgradeDiag.ps1" LogicalName="Payload/Invoke-Win11UpgradeDiag.ps1" />
    <EmbeddedResource Include="..\NOTICE.md" LogicalName="Payload/NOTICE.md" />
    <EmbeddedResource Include="..\VERSION" LogicalName="Payload/VERSION" />
    <EmbeddedResource Include="..\Watch-Win11Upgrade.ps1" LogicalName="Payload/Watch-Win11Upgrade.ps1" />
    <EmbeddedResource Include="..\Update-WupaActiveRun.ps1" LogicalName="Payload/Update-WupaActiveRun.ps1" />
  </ItemGroup>
</Project>
