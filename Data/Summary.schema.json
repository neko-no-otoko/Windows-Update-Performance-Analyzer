{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:win11upgradediag:summary:2.0.0",
  "title": "WUPA fact-only summary",
  "description": "Stable external-review contract for a finalized Windows Update Performance Analyzer 3.x run.",
  "type": "object",
  "required": [
    "SchemaVersion",
    "SchemaSemanticVersion",
    "ToolVersion",
    "AnalysisMode",
    "RuleCatalogVersion",
    "TargetMapVersion",
    "RunId",
    "Run",
    "Timestamps",
    "Sensitive",
    "Outcome",
    "StatusModel",
    "Recorder",
    "ExitCode",
    "Device",
    "SourceOs",
    "CurrentOs",
    "TargetOs",
    "PrimaryFinding",
    "Findings",
    "FindingCounts",
    "Facts",
    "FactCounts",
    "Attempts",
    "AttemptScope",
    "ExcludedEvidence",
    "CollectionCoverage",
    "CollectionGaps",
    "CollectionComplete",
    "ArtifactHashes",
    "Persistence",
    "ReviewBundle"
  ],
  "properties": {
    "SchemaVersion": { "const": 2 },
    "SchemaSemanticVersion": { "const": "2.0.0" },
    "ToolVersion": { "type": "string", "minLength": 1 },
    "AnalysisMode": { "enum": ["FactOnly", "DeterministicLegacy"] },
    "RuleCatalogVersion": { "type": "string", "minLength": 1 },
    "TargetMapVersion": { "type": "string", "minLength": 1 },
    "RunId": { "type": "string", "minLength": 1 },
    "Mode": { "type": "string" },
    "PhaseLabel": { "type": "string" },
    "StartedUtc": { "$ref": "#/$defs/nullableTimestamp" },
    "CompletedUtc": { "$ref": "#/$defs/nullableTimestamp" },
    "Run": {
      "type": "object",
      "required": ["RunId", "Mode", "PhaseLabel", "ComputerName", "StartedUtc", "CompletedUtc"],
      "properties": {
        "RunId": { "type": "string" },
        "Mode": { "type": "string" },
        "PhaseLabel": { "type": "string" },
        "ComputerName": { "$ref": "#/$defs/nullableString" },
        "StartedUtc": { "$ref": "#/$defs/nullableTimestamp" },
        "CompletedUtc": { "$ref": "#/$defs/nullableTimestamp" }
      },
      "additionalProperties": true
    },
    "Timestamps": {
      "type": "object",
      "required": ["StartedUtc", "CompletedUtc"],
      "properties": {
        "StartedUtc": { "$ref": "#/$defs/nullableTimestamp" },
        "CompletedUtc": { "$ref": "#/$defs/nullableTimestamp" }
      },
      "additionalProperties": true
    },
    "Sensitive": { "const": true },
    "Outcome": {
      "enum": ["Monitoring Armed", "Target OS Present", "Upgrade In Progress", "Upgrade Succeeded", "Rolled Back", "Failed", "No Upgrade Outcome Observed", "Ready", "Attention Required", "Blocked"]
    },
    "StatusModel": {
      "type": "object",
      "required": ["CurrentOsState", "BuildTransition", "AttemptOutcome", "DeploymentSource", "OutcomeBanner", "TargetPresent", "WindowsUpdateEvidenceConfirmed", "ObservedBuilds"],
      "properties": {
        "CurrentOsState": { "enum": ["TargetPresent", "TargetNotPresent", "Unreadable"] },
        "BuildTransition": { "enum": ["Observed", "NotObserved"] },
        "AttemptOutcome": { "enum": ["Succeeded", "Failed", "RolledBack", "InProgress", "NotObserved"] },
        "DeploymentSource": { "enum": ["WindowsUpdateConfirmed", "OtherConfirmed", "Unattributed"] },
        "OutcomeBanner": { "type": "string" },
        "TargetPresent": { "type": "boolean" },
        "WindowsUpdateEvidenceConfirmed": { "type": "boolean" },
        "ObservedBuilds": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "Recorder": {
      "type": ["object", "null"]
    },
    "UpgradeIdentity": {
      "type": ["object", "null"],
      "properties": {
        "Status": { "enum": ["Locked", "Ambiguous", "Incomplete", "NotObserved"] },
        "UpdateID": { "$ref": "#/$defs/nullableString" },
        "RevisionNumber": { "type": ["integer", "null"] },
        "ServiceID": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": true
    },
    "UpgradeTiming": {
      "type": ["object", "null"],
      "properties": {
        "Sessions": { "type": "array", "items": { "type": "object" } },
        "TargetOsFirstObserved": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "UpdateActivity": {
      "type": ["object", "null"],
      "properties": {
        "Updates": { "type": "array", "items": { "type": "object" } },
        "Timeline": { "type": "array", "items": { "type": "object" } },
        "UnattributedEventCount": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "ExitCode": { "enum": [0, 10, 20, 30] },
    "Device": {
      "type": "object",
      "required": ["ComputerName", "Domain", "Manufacturer", "Model", "SerialNumber", "UUID"],
      "additionalProperties": true
    },
    "SourceOs": { "$ref": "#/$defs/osIdentity" },
    "CurrentOs": { "$ref": "#/$defs/osIdentity" },
    "TargetOs": {
      "type": "object",
      "required": ["Product", "DisplayVersion", "BuildFamily"],
      "properties": {
        "Product": { "$ref": "#/$defs/nullableString" },
        "DisplayVersion": { "type": "string" },
        "BuildFamily": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "PrimaryFinding": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/finding" }
      ]
    },
    "Findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "FindingCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "Facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
    "FactCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "Attempts": { "type": "array", "items": { "type": "object" } },
    "AttemptScope": { "type": "object", "additionalProperties": true },
    "ExcludedEvidence": { "type": "array", "items": { "type": "object" } },
    "CollectionCoverage": { "type": "array", "items": { "$ref": "#/$defs/collectorRecord" } },
    "CollectionGaps": { "type": "array", "items": { "$ref": "#/$defs/collectionGap" } },
    "CollectionComplete": { "type": "boolean" },
    "ArtifactHashes": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "Persistence": { "type": ["object", "null"] },
    "ReviewBundle": { "type": ["object", "null"] }
  },
  "additionalProperties": true,
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableTimestamp": { "type": ["string", "null"], "format": "date-time" },
    "osIdentity": {
      "type": "object",
      "required": ["Product", "Edition", "DisplayVersion", "Build", "UBR"],
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["Reference", "SourcePath", "Excerpt"],
      "properties": {
        "Reference": { "type": "string", "minLength": 1 },
        "SourcePath": { "type": "string", "minLength": 1 },
        "Line": { "type": ["integer", "null"] },
        "TimestampUtc": { "$ref": "#/$defs/nullableTimestamp" },
        "Excerpt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "FindingId", "RuleId", "Severity", "Confidence", "Status", "Category", "Title",
        "Summary", "WhyItMatters", "Recommendation", "Codes", "Evidence", "MicrosoftReferences"
      ],
      "properties": {
        "FindingId": { "type": "string", "minLength": 1 },
        "RuleId": { "type": "string", "minLength": 1 },
        "Severity": { "enum": ["Blocker", "Error", "Warning", "Information"] },
        "Confidence": { "enum": ["High", "Medium", "Low"] },
        "Status": { "enum": ["Active", "Historical"] },
        "Category": { "type": "string" },
        "Title": { "type": "string" },
        "Summary": { "type": "string" },
        "WhyItMatters": { "type": "string" },
        "Recommendation": { "type": "string" },
        "Phase": { "$ref": "#/$defs/nullableString" },
        "Operation": { "$ref": "#/$defs/nullableString" },
        "ResultCode": { "$ref": "#/$defs/nullableString" },
        "ExtendCode": { "$ref": "#/$defs/nullableString" },
        "Codes": { "type": "array", "items": { "type": "string" } },
        "AffectedEntity": { "$ref": "#/$defs/nullableString" },
        "Evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "MicrosoftReferences": { "type": "array", "items": { "type": "string", "format": "uri" } }
      },
      "additionalProperties": true
    },
    "fact": {
      "type": "object",
      "required": ["FactId", "FactType", "Category", "Statement", "ScopeStatus", "EvidenceRef"],
      "properties": {
        "FactId": { "type": "string", "pattern": "^FACT-[0-9]{6}$" },
        "FactType": { "enum": ["Observed", "SourceReported", "Decoded", "Computed"] },
        "Category": { "type": "string", "minLength": 1 },
        "Statement": { "type": "string", "minLength": 1 },
        "TimestampUtc": { "$ref": "#/$defs/nullableTimestamp" },
        "AttemptId": { "$ref": "#/$defs/nullableString" },
        "Code": { "$ref": "#/$defs/nullableString" },
        "Phase": { "$ref": "#/$defs/nullableString" },
        "Operation": { "$ref": "#/$defs/nullableString" },
        "ScopeStatus": { "enum": ["Included", "ContextOnly", "Excluded"] },
        "EvidenceRef": { "$ref": "#/$defs/nullableString" },
        "Excerpt": { "$ref": "#/$defs/nullableString" },
        "ExcerptFile": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": true
    },
    "collectorRecord": {
      "type": "object",
      "required": ["Id", "Status", "StartedUtc", "EndedUtc", "DurationMs"],
      "additionalProperties": true
    },
    "collectionGap": {
      "type": "object",
      "required": ["Collector", "Source", "Status", "Impact"],
      "properties": {
        "Impact": { "enum": ["Optional", "Material"] }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": ["Name", "Length", "LastWriteUtc", "Sha256"],
      "properties": {
        "Name": { "type": "string" },
        "Length": { "type": "integer", "minimum": 0 },
        "LastWriteUtc": { "type": "string", "format": "date-time" },
        "Sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": true
    }
  }
}
